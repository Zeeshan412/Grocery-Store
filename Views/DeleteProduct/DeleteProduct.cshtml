@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Product";
}

<h3 class="mb-4"><i class="bi bi-trash text-danger"></i> Delete Product</h3>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle"></i> <strong>Warning:</strong> This action cannot be undone. The product will be permanently deleted.
</div>

@if (TempData["ProductMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ProductMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" action="/DeleteProduct/DeleteProduct" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');">
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label for="productId" class="form-label">Product ID <span class="text-danger">*</span></label>
                <input type="number" class="form-control" id="productId" name="ID" placeholder="Enter product ID to delete" min="1" required>
                <small class="form-text text-muted">Enter the ID of the product you want to delete</small>
            </div>
        </div>
    </div>
    
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-admin btn-admin-danger">
            <i class="bi bi-trash"></i> Delete Product
        </button>
        <a asp-controller="Admin" asp-action="Admin" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</form>
